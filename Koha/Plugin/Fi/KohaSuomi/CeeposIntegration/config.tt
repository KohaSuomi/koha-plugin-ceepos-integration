[% TRY %]
    [% PROCESS "$PLUGIN_DIR/i18n/${LANG}.inc" %]
[% CATCH %]
    [% PROCESS "$PLUGIN_DIR/i18n/default.inc" %]
[% END %]
[% USE KohaDates %]
[% USE Asset %]
[% USE raw %]
[% INCLUDE 'doc-head-open.inc' %]
<title>[% T.config_1 %]</title>
[% Asset.css("lib/codemirror/codemirror.min.css") | $raw %]
<style>
.code-example {
    background: #f6f8fa;
    border: 1px solid #d9dee3;
    border-radius: 0.4rem;
    padding: 0.75rem 0.85rem;
    margin: 0.5rem 0 0;
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
}
</style>
[% INCLUDE 'doc-head-close.inc' %]
</head>
<body id="plugins_ceepos_configure" class="plugins">
[% WRAPPER 'header.inc' %]
    [% INCLUDE 'cat-search.inc' %]
[% END %]

<div class="main container-fluid">
    <div class="row">
        <div class="col-12 col-xl-10">
            <main>

                [% INCLUDE 'messages.inc' %]

                <div id="breadcrumbs"><a href="/cgi-bin/koha/mainpage.pl">[% T.config_2 %]</a> &rsaquo; <a href="/cgi-bin/koha/plugins/plugins-home.pl">[% T.config_3 %]</a>[% T.config_4 %]</div>

                [% IF saved %]
                    <div class="alert alert-success mt-3">[% T.config_5 %]</div>
                [% END %]

                <div class="page-section mt-3">

                    <h1>[% T.config_6 %]</h1>

                    <form method="post" class="validated">
                        [% INCLUDE 'csrf-token.inc' %]
                        <input type="hidden" name="class" value="[% CLASS | html %]"/>
                        <input type="hidden" name="method" value="[% METHOD | html %]"/>
                        <input type="hidden" name="save" value="1" />

                        <fieldset class="rows">
                            <ol>
                                <li>
                                    <label for="ceeposintegration">[% T.config_7 %]</label>
                                    <textarea id="ceeposintegration" name="ceeposintegration" rows="6" cols="70">[% ceeposintegration | html %]</textarea>
                                    <div class="hint">[% T.config_8 %]
                                    <pre class="code-example"><code>CPL:
  "KOHA PRODUCT": CEEPOS_PRODUCT
  KOHA_PRODUCT: CEEPOS_PRODUCT
MNL:
  KOHA_PRODUCT: CEEPOS_PRODUCT</code></pre></div>
                                </li>
                            </ol>
                        </fieldset>

                        <fieldset class="action">
                            <input type="submit" class="btn btn-primary" value="[% T.config_9 %]" />
                            <a class="btn btn-default" href="/cgi-bin/koha/plugins/plugins-home.pl">[% T.config_10 %]</a>
                        </fieldset>
                    </form>

                </div>

            </main>
        </div>
    </div>
</div>

[% Asset.js("lib/codemirror/codemirror.min.js") | $raw %]
[% Asset.js("lib/codemirror/yaml.min.js") | $raw %]
<script>
    var editor = CodeMirror.fromTextArea(document.getElementById("ceeposintegration"), {
        mode: "yaml",
        lineNumbers: true,
        lineWrapping: true
    });
</script>

[% INCLUDE 'intranet-bottom.inc' %]
